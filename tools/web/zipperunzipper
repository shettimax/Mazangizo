                    <span class="file-size">
                        <?= $f['size'] > 1048576 ? round($f['size']/1048576,2).' MB' : ($f['size'] > 1024 ? round($f['size']/1024,2).' KB' : $f['size'].' B') ?>
                    </span>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
        <?php if (empty($paginated['files'])): ?>
            <div class="file-item file-other">(empty)</div>
        <?php endif; ?>
    </div>

    <div class="footer">
        v<?= VERSION ?> | ZIP | GZ | TAR | RAR | 7Z | BZ2
    </div>
</div>

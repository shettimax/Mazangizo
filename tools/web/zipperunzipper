<?php
/**
 * Universal Unzipper - PHP 5.0 - 8.x Compatible
 * Supports: ZipArchive, Zlib, PharData, System unzip, Pure PHP
 * Paginated file listing to prevent browser crashes
 * Stealth Mode - No visible app references
 */

error_reporting(0);
define('VERSION', '0.4.1');

$timestart = microtime(true);
$GLOBALS['status'] = array();

class Unzipper {
    public $localdir = '.';
    public $zipfiles = array();
    public $available_methods = array();
    public $total_files = 0;

    public function __construct() {
        $this->detectMethods();
        $this->scanArchives();
    }

    public function detectMethods() {
        if (class_exists('ZipArchive', false)) {
            $this->available_methods[] = 'ZipArchive';
        }
        
        if (class_exists('PharData', false)) {
            $this->available_methods[] = 'PharData';
        }
        
        if (function_exists('gzopen') && function_exists('gzinflate')) {
            $this->available_methods[] = 'Zlib';
        }
        
        if (function_exists('bzopen')) {
            $this->available_methods[] = 'Bzip2';
        }
        
        $cmds = array('unzip', '7z', '7za', 'bsdtar', 'tar', 'gunzip', 'bunzip2');
        foreach ($cmds as $cmd) {
            $output = @shell_exec("command -v $cmd 2>/dev/null");
            if (!empty(trim($output))) {
                $this->available_methods[] = strtoupper($cmd);
            }
        }
        
        $this->available_methods[] = 'PurePHP';
    }

    public function scanArchives() {
        $count = 0;
        $this->total_files = 0;
        
        if ($dh = @opendir($this->localdir)) {
            while (($file = readdir($dh)) !== false) {
                $this->total_files++;
                $ext = strtolower(pathinfo($file, PATHINFO_EXTENSION));
                if (in_array($ext, array('zip', 'gz', 'tar', 'rar', '7z', 'bz2'))) {
                    $this->zipfiles[] = $file;
                    $count++;
                }
            }
            closedir($dh);
        }

        if (!empty($this->zipfiles)) {
            $GLOBALS['status'] = array('info' => 'Found ' . count($this->zipfiles) . ' archive(s).');
        } else {
            $GLOBALS['status'] = array('info' => 'No archives found.');
        }
    }

    public function prepareExtraction($archive, $destination = '') {
        $destination = $destination ?: $this->localdir;
        
        if (!is_dir($destination)) {
            @mkdir($destination, 0777, true);
        }

        if (!in_array($archive, $this->zipfiles)) {
            $GLOBALS['status'] = array('error' => 'Archive not found: ' . $archive);
            return;
        }

        $ext = strtolower(pathinfo($archive, PATHINFO_EXTENSION));
        
        if ($ext === 'zip') {
            $this->extractZip($archive, $destination);
        } elseif ($ext === 'gz') {
            $this->extractGzip($archive, $destination);
        } elseif ($ext === 'tar') {
            $this->extractTar($archive, $destination);
        } elseif ($ext === 'rar') {
            $this->extractRar($archive, $destination);
        } elseif ($ext === '7z') {
            $this->extract7z($archive, $destination);
        } elseif ($ext === 'bz2') {
            $this->extractBz2($archive, $destination);
        } else {
            $GLOBALS['status'] = array('error' => 'Unsupported format: ' . $ext);
        }
    }

    // ==================== ZIP EXTRACTION ====================
    public function extractZip($archive, $destination) {
        if (class_exists('ZipArchive', false)) {
            $zip = new ZipArchive();
            if ($zip->open($archive) === true) {
                $zip->extractTo($destination);
                $zip->close();
                $GLOBALS['status'] = array('success' => 'Extracted using ZipArchive.');
                return;
            }
        }
        
        $unzip_path = trim(@shell_exec("command -v unzip 2>/dev/null"));
        if (!empty($unzip_path)) {
            $cmd = escapeshellcmd($unzip_path) . " -o " . escapeshellarg($archive) . " -d " . escapeshellarg($destination) . " 2>&1";
            @shell_exec($cmd);
            $GLOBALS['status'] = array('success' => 'Extracted using system unzip.');
            return;
        }
        
        $sevenz_path = trim(@shell_exec("command -v 7z 2>/dev/null"));
        if (!empty($sevenz_path)) {
            $cmd = escapeshellcmd($sevenz_path) . " x " . escapeshellarg($archive) . " -o" . escapeshellarg($destination) . " -y 2>&1";
            $output = @shell_exec($cmd);
            if (strpos($output, 'Everything is Ok') !== false) {
                $GLOBALS['status'] = array('success' => 'Extracted using 7z.');
                return;
            }
        }
        
        if (function_exists('gzinflate')) {
            $result = $this->extractZipPurePHP($archive, $destination);
            if ($result) {
                $GLOBALS['status'] = array('success' => 'Extracted using Pure PHP + Zlib.');
                return;
            }
        }
        
        $GLOBALS['status'] = array('error' => 'No working ZIP extraction method available.');
    }

    public function extractZipPurePHP($archive, $destination) {
        $data = @file_get_contents($archive);
        if (substr($data, 0, 2) !== 'PK') return false;
        
        $extracted = 0;
        $pos = 0;
        $len = strlen($data);
        
        while ($pos < $len) {
            $sig = @unpack('V', substr($data, $pos, 4));
            if (!$sig || $sig[1] != 0x04034B50) {
                $pos++;
                continue;
            }
            
            $offset = $pos;
            $method = @unpack('v', substr($data, $offset + 8, 2));
            $compressed = @unpack('V', substr($data, $offset + 18, 4));
            $filename_len = @unpack('v', substr($data, $offset + 26, 2));
            $extra_len = @unpack('v', substr($data, $offset + 28, 2));
            
            if (!$method || !$compressed || !$filename_len || !$extra_len) break;
            
            $method = $method[1];
            $compressed = $compressed[1];
            $filename_len = $filename_len[1];
            $extra_len = $extra_len[1];
            
            $filename = substr($data, $offset + 30, $filename_len);
            
            if (strpos($filename, '__MACOSX/') === 0 || 
                strpos($filename, '.DS_Store') !== false ||
                strpos($filename, 'Thumbs.db') !== false) {
                $pos = $offset + 30 + $filename_len + $extra_len + $compressed;
                continue;
            }
            
            $compressed_data = substr($data, $offset + 30 + $filename_len + $extra_len, $compressed);
            
            if ($method == 0) {
                $file_data = $compressed_data;
            } elseif ($method == 8) {
                $file_data = @gzinflate($compressed_data);
                if ($file_data === false) {
                    $file_data = @gzinflate(substr($compressed_data, 2));
                }
                if ($file_data === false) {
                    $pos = $offset + 30 + $filename_len + $extra_len + $compressed;
                    continue;
                }
            } else {
                $pos = $offset + 30 + $filename_len + $extra_len + $compressed;
                continue;
            }
            
            $out_path = $destination . '/' . str_replace('\\', '/', $filename);
            $dir = dirname($out_path);
            if (!is_dir($dir)) {
                @mkdir($dir, 0777, true);
            }
            
            if (substr($filename, -1) == '/') {
                if (!is_dir($out_path)) @mkdir($out_path, 0777, true);
            } else {
                @file_put_contents($out_path, $file_data);
                $extracted++;
            }
            
            $pos = $offset + 30 + $filename_len + $extra_len + $compressed;
        }
        
        return $extracted > 0;
    }

    // ==================== GZIP EXTRACTION ====================
    public function extractGzip($archive, $destination) {
        $filename = pathinfo($archive, PATHINFO_FILENAME);
        $outFile = $destination . '/' . $filename;

        if (class_exists('PharData', false)) {
            try {
                $phar = new PharData($archive);
                $phar->decompress();
                $tar_file = $destination . '/' . $filename . '.tar';
                if (file_exists($tar_file)) {
                    $this->extractTar($tar_file, $destination);
                    @unlink($tar_file);
                    $GLOBALS['status'] = array('success' => 'Extracted using PharData.');
                    return;
                }
            } catch (Exception $e) {}
        }
        
        $gunzip_path = trim(@shell_exec("command -v gunzip 2>/dev/null"));
        if (!empty($gunzip_path)) {
            @copy($archive, $destination . '/' . $filename . '.gz');
            $cmd = escapeshellcmd($gunzip_path) . " -f " . escapeshellarg($destination . '/' . $filename . '.gz') . " 2>&1";
            @shell_exec($cmd);
            if (file_exists($outFile)) {
                if (pathinfo($outFile, PATHINFO_EXTENSION) === 'tar') {
                    $this->extractTar($outFile, $destination);
                    @unlink($outFile);
                }
                $GLOBALS['status'] = array('success' => 'Extracted using system gunzip.');
                return;
            }
        }
        
        if (function_exists('gzopen')) {
            $gz = @gzopen($archive, 'rb');
            if ($gz) {
                $fp = @fopen($outFile, 'wb');
                if ($fp) {
                    while (!gzeof($gz)) {
                        fwrite($fp, gzread($gz, 4096));
                    }
                    fclose($fp);
                }
                gzclose($gz);
                
                if (file_exists($outFile)) {
                    if (pathinfo($outFile, PATHINFO_EXTENSION) === 'tar') {
                        $this->extractTar($outFile, $destination);
                        @unlink($outFile);
                    }
                    $GLOBALS['status'] = array('success' => 'Extracted using Zlib.');
                    return;
                }
            }
        }
        
        $GLOBALS['status'] = array('error' => 'Failed to extract .gz file.');
    }

    // ==================== TAR EXTRACTION ====================
    public function extractTar($tar_file, $destination) {
        if (class_exists('PharData', false)) {
            try {
                $phar = new PharData($tar_file);
                $phar->extractTo($destination);
                $GLOBALS['status'] = array('success' => 'Extracted TAR using PharData.');
                return;
            } catch (Exception $e) {}
        }
        
        $tar_path = trim(@shell_exec("command -v tar 2>/dev/null"));
        if (!empty($tar_path)) {
            $cmd = escapeshellcmd($tar_path) . " -xf " . escapeshellarg($tar_file) . " -C " . escapeshellarg($destination) . " 2>&1";
            @shell_exec($cmd);
            $GLOBALS['status'] = array('success' => 'Extracted TAR using system tar.');
            return;
        }
        
        if (!file_exists($tar_file)) {
            $GLOBALS['status'] = array('error' => 'TAR file not found.');
            return;
        }

        $fp = @fopen($tar_file, 'rb');
        if (!$fp) {
            $GLOBALS['status'] = array('error' => 'Cannot open TAR file.');
            return;
        }
        
        $extracted = 0;

        while (!feof($fp)) {
            $header = fread($fp, 512);
            if (strlen($header) < 512) break;

            $filename = trim(substr($header, 0, 100));
            if (empty($filename)) break;

            $size = octdec(trim(substr($header, 124, 12)));
            $typeflag = substr($header, 156, 1);

            $outPath = $destination . '/' . $filename;
            $dir = dirname($outPath);

            if (!is_dir($dir)) @mkdir($dir, 0777, true);

            if ($typeflag == '5') {
                if (!is_dir($outPath)) @mkdir($outPath, 0777, true);
            } else {
                $data = fread($fp, $size);
                @file_put_contents($outPath, $data);
                $extracted++;
            }

            $padding = (512 - ($size % 512)) % 512;
            if ($padding > 0) fread($fp, $padding);
        }

        fclose($fp);
        $GLOBALS['status'] = array('success' => "Extracted $extracted files from TAR using Pure PHP.");
    }

    // ==================== RAR EXTRACTION ====================
    public function extractRar($archive, $destination) {
        if (class_exists('RarArchive', false)) {
            $rar = RarArchive::open($archive);
            if ($rar) {
                $entries = $rar->getEntries();
                foreach ($entries as $entry) {
                    $entry->extract($destination);
                }
                $rar->close();
                $GLOBALS['status'] = array('success' => 'Extracted RAR using RarArchive.');
                return;
            }
        }
        
        $unrar_path = trim(@shell_exec("command -v unrar 2>/dev/null"));
        if (!empty($unrar_path)) {
            $cmd = escapeshellcmd($unrar_path) . " x -o+ " . escapeshellarg($archive) . " " . escapeshellarg($destination) . " 2>&1";
            @shell_exec($cmd);
            $GLOBALS['status'] = array('success' => 'Extracted RAR using system unrar.');
            return;
        }
        
        $GLOBALS['status'] = array('error' => 'No RAR extraction method available.');
    }

    // ==================== 7Z EXTRACTION ====================
    public function extract7z($archive, $destination) {
        $sevenz_path = trim(@shell_exec("command -v 7z 2>/dev/null"));
        if (!empty($sevenz_path)) {
            $cmd = escapeshellcmd($sevenz_path) . " x " . escapeshellarg($archive) . " -o" . escapeshellarg($destination) . " -y 2>&1";
            $output = @shell_exec($cmd);
            if (strpos($output, 'Everything is Ok') !== false) {
                $GLOBALS['status'] = array('success' => 'Extracted 7z using 7z.');
                return;
            }
        }
        $GLOBALS['status'] = array('error' => 'No 7z extraction method available.');
    }

    // ==================== BZIP2 EXTRACTION ====================
    public function extractBz2($archive, $destination) {
        $filename = pathinfo($archive, PATHINFO_FILENAME);
        $outFile = $destination . '/' . $filename;

        $bunzip2_path = trim(@shell_exec("command -v bunzip2 2>/dev/null"));
        if (!empty($bunzip2_path)) {
            @copy($archive, $destination . '/' . $filename . '.bz2');
            $cmd = escapeshellcmd($bunzip2_path) . " -f " . escapeshellarg($destination . '/' . $filename . '.bz2') . " 2>&1";
            @shell_exec($cmd);
            if (file_exists($outFile)) {
                $GLOBALS['status'] = array('success' => 'Extracted BZ2 using system bunzip2.');
                return;
            }
        }
        
        if (function_exists('bzopen')) {
            $bz = @bzopen($archive, 'r');
            if ($bz) {
                $fp = @fopen($outFile, 'wb');
                if ($fp) {
                    while (!feof($bz)) {
                        fwrite($fp, bzread($bz, 4096));
                    }
                    fclose($fp);
                }
                bzclose($bz);
                
                if (file_exists($outFile)) {
                    $GLOBALS['status'] = array('success' => 'Extracted BZ2 using PHP Bzip2.');
                    return;
                }
            }
        }
        $GLOBALS['status'] = array('error' => 'No BZIP2 extraction method available.');
    }
}

// ====================== ZIPPING FUNCTIONALITY ======================
class Zipper {
    public static function zipDir($sourcePath, $outZipPath) {
        if (!class_exists('ZipArchive', false)) {
            $GLOBALS['status'] = array('error' => 'ZipArchive not available. Cannot create ZIP.');
            return;
        }
        
        $sourcePath = rtrim($sourcePath, '/');
        $pathInfo = pathinfo($sourcePath);
        $dirName = $pathInfo['basename'];
        
        $zip = new ZipArchive();
        if ($zip->open($outZipPath, ZipArchive::CREATE) !== true) {
            $GLOBALS['status'] = array('error' => 'Cannot create ZIP archive.');
            return;
        }
        
        self::addFolderToZip($sourcePath, $zip, strlen($sourcePath) - strlen($dirName));
        $zip->close();
        $GLOBALS['status'] = array('success' => 'Created archive: ' . $outZipPath);
    }
    
    private static function addFolderToZip($folder, &$zip, $exclusiveLength) {
        $handle = @opendir($folder);
        if (!$handle) return;
        
        while (($file = readdir($handle)) !== false) {
            if ($file != '.' && $file != '..') {
                $filePath = "$folder/$file";
                $localPath = substr($filePath, $exclusiveLength);
                if (is_file($filePath)) {
                    $zip->addFile($filePath, $localPath);
                } elseif (is_dir($filePath)) {
                    $zip->addEmptyDir($localPath);
                    self::addFolderToZip($filePath, $zip, $exclusiveLength);
                }
            }
        }
        closedir($handle);
    }
}

// ====================== PAGINATION HELPERS ======================
function getPaginatedFiles($page = 1, $per_page = 50) {
    $files = array();
    $total = 0;
    
    if ($dh = @opendir('.')) {
        while (($file = readdir($dh)) !== false) {
            if ($file != '.' && $file != '..') {
                $total++;
                $ext = strtolower(pathinfo($file, PATHINFO_EXTENSION));
                if (in_array($ext, array('zip', 'gz', 'tar', 'rar', '7z', 'bz2'))) {
                    $files[] = array(
                        'name' => $file,
                        'size' => @filesize($file),
                        'is_archive' => true
                    );
                } else {
                    $files[] = array(
                        'name' => $file,
                        'size' => is_file($file) ? @filesize($file) : 0,
                        'is_archive' => false
                    );
                }
            }
        }
        closedir($dh);
    }
    
    usort($files, function($a, $b) {
        return strcasecmp($a['name'], $b['name']);
    });
    
    $total_files = count($files);
    $total_pages = ceil($total_files / $per_page);
    $page = max(1, min($page, $total_pages));
    $offset = ($page - 1) * $per_page;
    $paginated = array_slice($files, $offset, $per_page);
    
    return array(
        'files' => $paginated,
        'total' => $total_files,
        'page' => $page,
        'per_page' => $per_page,
        'total_pages' => $total_pages
    );
}

